{
  "name": "theinstitute",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --config firebase.test.json --only firestore,database --project demo-institute \"node tests/rules.test.mjs && node tests/rtdb.test.mjs\"",
    "dev:emu": "vite --mode emulators --port 5181 --strictPort",
    "emulators": "firebase emulators:start --only auth,firestore,database --project demo-institute",
    "stats:emu": "node --env-file-if-exists=.env.stats scripts/compute-stats.mjs --force"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "firebase": "^13.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^13.35.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  }
}
