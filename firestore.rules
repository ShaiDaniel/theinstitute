rules_version = '2';

// Security rules for The Institute (Firestore). Published in Firebase console →
// Firestore Database → Rules. Anything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A member is someone signed in who has created a profile.
    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function validProfile(data) {
      return data.keys().hasOnly(['name', 'photo', 'visibility', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 60
        && (data.photo == null || (data.photo is string && data.photo.size() <= 2000))
        && data.visibility in ['public', 'members']
        && data.updatedAt == request.time;
    }

    // Member profiles (name and photo): public while the member has a public list, otherwise
    // members-only. Only the member can write their own.
    match /members/{uid} {
      allow read: if resource.data.visibility == 'public'
        || isMember()
        || (signedIn() && request.auth.uid == uid);

      allow create: if signedIn() && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn() && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if signedIn() && request.auth.uid == uid;

      // Showcase lists: named and ranked, one kind each (albums, bands, songs or concerts). Each
      // list is private (owner only), members-only or public.
      match /lists/{listId} {
        allow read: if canSee(resource.data.visibility, uid);

        allow create: if signedIn() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/members/$(uid))
          && validList(uid, request.resource.data)
          && request.resource.data.createdAt == request.time;

        allow update: if signedIn() && request.auth.uid == uid
          && validList(uid, request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'visibility', 'position', 'updatedAt']);

        allow delete: if signedIn() && request.auth.uid == uid;

        // One item in a list (the document id is the item id), with its own score, tags and note.
        // It carries a copy of the list's visibility, which may be stricter but never looser than
        // the list's (so the owner can narrow entries before the list, and widen the list first).
        match /entries/{itemId} {
          allow read: if canSee(resource.data.visibility, uid);

          allow create: if signedIn() && request.auth.uid == uid
            && validEntry(uid, listId, itemId, request.resource.data)
            && request.resource.data.createdAt == request.time;

          allow update: if signedIn() && request.auth.uid == uid
            && validEntry(uid, listId, itemId, request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['position', 'score', 'tags', 'note', 'visibility', 'image', 'updatedAt']);

          allow delete: if signedIn() && request.auth.uid == uid;
        }
      }
    }

    function canSee(visibility, uid) {
      return visibility == 'public'
        || (visibility == 'members' && isMember())
        || (signedIn() && request.auth.uid == uid);
    }

    function level(visibility) {
      return visibility == 'public' ? 2 : (visibility == 'members' ? 1 : 0);
    }

    function validList(uid, data) {
      return data.keys().hasOnly(['uid', 'kind', 'name', 'visibility', 'position', 'createdAt', 'updatedAt'])
        && data.uid == uid
        && data.kind in ['album', 'band', 'song', 'concert']
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.visibility in ['private', 'members', 'public']
        && data.position is number
        && data.updatedAt == request.time;
    }

    function validEntry(uid, listId, itemId, data) {
      let list = getAfter(/databases/$(database)/documents/members/$(uid)/lists/$(listId));
      return data.keys().hasOnly(['uid', 'listId', 'kind', 'itemId', 'title', 'artist', 'year', 'image', 'ref',
                                  'position', 'score', 'tags', 'note', 'visibility', 'createdAt', 'updatedAt'])
        && list != null
        && data.visibility in ['private', 'members', 'public']
        && level(data.visibility) <= level(list.data.visibility)
        && data.uid == uid
        && data.listId == listId
        && data.kind == list.data.kind
        && data.itemId == itemId
        && itemId.matches('^' + data.kind + ':[^/]{1,200}$')
        && data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.artist is string && data.artist.size() <= 300
        && (data.year == null || data.year is int)
        && (data.image == null || (data.image is string && data.image.size() <= 1000))
        && data.ref is string && data.ref.size() <= 100
        && data.position is number
        && data.score is number && data.score >= 1 && data.score <= 10
        && math.floor(data.score * 2) == data.score * 2
        && data.tags is list && data.tags.size() <= 9
        && data.tags.toSet().hasOnly(['lifeChanging', 'classic', 'desertIsland', 'guiltyPleasure', 'grewOnMe',
                                      'underrated', 'overrated', 'agedBadly', 'legendaryNight'])
        && data.note is string && data.note.size() <= 1000
        && data.updatedAt == request.time;
    }

    // Concerts: one per band per day (id "dz<band>_<date>"), shared by every member who was there.
    // Members create them and keep the facts up to date together (venue, setlist); the band and
    // the date, which make up the id, never change. Attendees' scores live in their own lists.
    match /concerts/{concertId} {
      allow read: if true;
      allow create: if isMember()
        && validConcert(concertId, request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isMember()
        && validConcert(concertId, request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['venue', 'city', 'country', 'setlist', 'setlistUrl', 'updatedBy', 'updatedAt']);
    }

    function validConcert(concertId, data) {
      return data.keys().hasOnly(['bandDz', 'band', 'image', 'date', 'venue', 'city', 'country', 'setlist', 'setlistUrl',
                                  'createdBy', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.bandDz is int
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && concertId == 'dz' + string(data.bandDz) + '_' + data.date
        && data.band is string && data.band.size() > 0 && data.band.size() <= 300
        && (data.image == null || (data.image is string && data.image.size() <= 1000))
        && data.venue is string && data.venue.size() > 0 && data.venue.size() <= 120
        && data.city is string && data.city.size() <= 120
        && data.country is string && data.country.size() <= 120
        && data.setlist is list && data.setlist.size() <= 80
        && (data.setlistUrl == null
            || (data.setlistUrl is string && data.setlistUrl.matches('^https://(www[.])?setlist[.]fm/setlist/[^ ]{1,300}$')))
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    // Home page metrics, written only by the hourly job (scripts/compute-stats.mjs, admin access).
    // stats/source is the job's own bookkeeping.
    match /stats/public {
      allow read: if true;
    }
    match /stats/members {
      allow read: if isMember();
    }

    // "Who ranked it": everyone's entries for one item, queried across members.
    match /{path=**}/entries/{itemId} {
      allow read: if resource.data.visibility == 'public'
        || (resource.data.visibility == 'members' && isMember());
    }
  }
}
